# GEMINI_API_KEY: Required server-side for Gemini AI Assistant (/api/ai/assist).
# Never expose this key in frontend bundles or VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional server-side model override (defaults to gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The public URL where this applet or deployment is hosted.
APP_URL="http://localhost:3000"

# GOOGLE_CLOUD_PROJECT / FIREBASE_PROJECT_ID: Used by firebase-admin token verifier on the server.
# Optional when firebase-applet-config.json provides projectId.
FIREBASE_PROJECT_ID=""

# GOOGLE_APPLICATION_CREDENTIALS: Path to a service account JSON if running outside GCP/ADC
# and firebase-admin cannot reach Google public keys automatically.
# Note: firebase-admin verifyIdToken uses Google JWKS endpoints cleanly with just projectId in most environments.
GOOGLE_APPLICATION_CREDENTIALS=""

# VITE_RECAPTCHA_SITE_KEY: Optional Google reCAPTCHA v3 site key for Firebase App Check.
# Leave blank to keep guarded App Check gracefully disabled until configured in Firebase Console.
VITE_RECAPTCHA_SITE_KEY=""

# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN: Optional App Check debug token for local development only.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# FIRESTORE_EMULATOR_HOST: Set by `firebase emulators:exec` or manually (e.g. 127.0.0.1:8080)
# when running `npm run test:rules` against the live Firestore Rules Emulator.
FIRESTORE_EMULATOR_HOST=""
